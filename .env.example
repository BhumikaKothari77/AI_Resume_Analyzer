# Google Gemini API Key (Optional - enables deep AI analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# n8n Webhook URL (Optional - if using external n8n workflow)
VITE_N8N_WEBHOOK_URL=

# Set to true only if you want hardcoded sample mock data
VITE_USE_MOCK_API=false
